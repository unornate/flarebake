#!/usr/bin/env bash
#
# build.sh - Bake the JBake site for Cloudflare Workers.
#
# Generated by flarebake.
#
# Cloudflare's Workers Builds image (Ubuntu 24.04) ships Node, Python, Ruby,
# Go and Hugo, but *not* a Java runtime. JBake needs Java, so this script
# downloads a private Temurin JRE and the JBake distribution into .tools/
# (git-ignored) and then bakes the site into ./output.
#
# Wrangler runs this automatically via the [build] block in wrangler.toml
# every time `wrangler deploy` is invoked.

set -euo pipefail

JBAKE_VERSION="${JBAKE_VERSION:-{{JBAKE_VERSION}}}"
JAVA_VERSION="${JAVA_VERSION:-{{JAVA_VERSION}}}"

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TOOLS_DIR="${ROOT_DIR}/.tools"
JAVA_DIR="${TOOLS_DIR}/java"
JBAKE_DIR="${TOOLS_DIR}/jbake-${JBAKE_VERSION}-bin"

cd "${ROOT_DIR}"

log() { printf '\n==> %s\n' "$*"; }

mkdir -p "${TOOLS_DIR}"

# --- 1. Java runtime (Temurin JRE, no root required) ------------------------
if [ ! -x "${JAVA_DIR}/bin/java" ]; then
	log "Installing Temurin JRE ${JAVA_VERSION} into .tools/java"
	mkdir -p "${JAVA_DIR}"
	curl -fsSL \
		"https://api.adoptium.net/v3/binary/latest/${JAVA_VERSION}/ga/linux/x64/jre/hotspot/normal/eclipse" \
		-o "${TOOLS_DIR}/java.tar.gz"
	tar -xzf "${TOOLS_DIR}/java.tar.gz" -C "${JAVA_DIR}" --strip-components=1
	rm -f "${TOOLS_DIR}/java.tar.gz"
fi

export JAVA_HOME="${JAVA_DIR}"
export PATH="${JAVA_HOME}/bin:${PATH}"
java -version

# --- 2. JBake ---------------------------------------------------------------
if [ ! -x "${JBAKE_DIR}/bin/jbake" ]; then
	log "Downloading JBake ${JBAKE_VERSION}"
	curl -fsSL \
		"https://github.com/jbake-org/jbake/releases/download/v${JBAKE_VERSION}/jbake-${JBAKE_VERSION}-bin.zip" \
		-o "${TOOLS_DIR}/jbake.zip"
	unzip -q -o "${TOOLS_DIR}/jbake.zip" -d "${TOOLS_DIR}"
	rm -f "${TOOLS_DIR}/jbake.zip"
fi

JBAKE_BIN="${JBAKE_DIR}/bin/jbake"
if [ ! -x "${JBAKE_BIN}" ]; then
	echo "ERROR: JBake launcher not found at ${JBAKE_BIN}" >&2
	exit 1
fi

# --- 3. Bake ----------------------------------------------------------------
log "Baking site into ./output"
rm -rf "${ROOT_DIR}/output"
"${JBAKE_BIN}" -b "${ROOT_DIR}" "${ROOT_DIR}/output"

log "Done. output/ now contains:"
ls -la "${ROOT_DIR}/output"
